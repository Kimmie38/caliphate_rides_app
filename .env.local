# Caliphate Rides app settings (read when Expo starts: restart with  npx expo start -c  after changes)
EXPO_PUBLIC_USE_MOCK=false
# Backend on the VPS
EXPO_PUBLIC_API_URL=https://api.caliphaterides.com.ng
# Testing outside Sokoto. Remove this line (and SERVICE_AREA=anywhere on the backend) for real use.
EXPO_PUBLIC_SERVICE_AREA=anywhere
EXPO_PUBLIC_ROUTING_URL=https://routing.caliphaterides.com.ng
# Our own Sokoto map (tiles + label fonts). Outside Sokoto State the app uses the public map instead.
EXPO_PUBLIC_MAP_TILES_URL=https://tiles.caliphaterides.com.ng/sokoto
EXPO_PUBLIC_MAP_GLYPHS_URL=https://tiles.caliphaterides.com.ng/font/{fontstack}/{range}