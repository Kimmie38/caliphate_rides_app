# Copy this file to .env and fill in the values.

# true  = the app runs on built-in sample data (no backend needed)
# false = the app talks to the Node.js backend below
EXPO_PUBLIC_USE_MOCK=true

# Sample mode only. true = if you're outside Sokoto, Sokoto's places are moved around
# your real location so you can try the app where you are. false = show Sokoto itself.
EXPO_PUBLIC_DEMO_AT_MY_LOCATION=true

# Base URL of the Node.js + MongoDB backend, e.g. https://api.caliphaterides.ng
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# ---- Our map ----
# The map, routes and place search run on OpenStreetMap data (see caliphate-map-server/README.md).
# Leave these empty to use free public servers while testing.
# Before launch, point them at our own Sokoto map server.
EXPO_PUBLIC_MAP_TILES_URL=
EXPO_PUBLIC_MAP_GLYPHS_URL=
EXPO_PUBLIC_ROUTING_URL=
EXPO_PUBLIC_SEARCH_URL=
# Map engine: leave empty to choose automatically (native in your own build, web view in Expo Go).
# Set to web to use the web view everywhere.
EXPO_PUBLIC_MAP_ENGINE=

# Optional: also search Google Places (needs a key with Places API enabled). Not needed for the map.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Link people open when a rider shares their trip
EXPO_PUBLIC_SHARE_BASE_URL=https://caliphaterides.ng/t


